{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite",
      "type": "shell",
      "command": "npx vite --host 127.0.0.1 --port 5176",
      "isBackground": true,
      "presentation": { "reveal": "silent" },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.+):\\s+(\\d+):\\d+\\s+(?:error|warning|INFO)\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": false,
          "beginsPattern": "^\\s*VITE",
          "endsPattern": "Local:.*http://127\\.0\\.0\\.1:5176"
        }
      }
    }
  ]
}
